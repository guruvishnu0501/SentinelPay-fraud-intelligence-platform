# Render PostgreSQL Database Configuration (Production)
# DATABASE_URL=postgresql://username:password@host:5432/database

# Render Persistent Disk SQLite Configuration (Optional)
# Set SENTINELPAY_DB_PATH or DATA_DIR if mounting a Render Persistent Disk (e.g. /var/data)
# DATA_DIR=/var/data
# SENTINELPAY_DB_PATH=/var/data/sentinelpay.db

# MySQL Database Configuration Example (Optional)
# Copy this file to .env and set your local MySQL credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=sentinelpay_db

